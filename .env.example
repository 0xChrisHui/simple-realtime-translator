# OpenAI API keys are entered in the app in this branch.
# Optional fallback for Soniox provider; required for the free-trial path.
# SONIOX_API_KEY=your-soniox-api-key
# Optional. Used to hash a safety identifier per visitor and to sign the trial quota cookie.
SAFETY_SALT=change-me
# Optional. Public URL or public-path image for the on-screen watermark.
# NEXT_PUBLIC_WATERMARK_IMAGE=/watermark.png

# Free-trial gate: full (Redis + cookie) / cookie-only / off
TRIAL_ENABLED=full
TRIAL_SECONDS=180
TRIAL_PER_CLIENT_PER_DAY=2
TRIAL_GLOBAL_PER_DAY=100
# Required only when TRIAL_ENABLED=full (auto-injected when you add the
# Upstash Redis integration on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated origins allowed to use the trial. Leave empty to skip the
# Origin check (local development).
ALLOWED_ORIGINS=
